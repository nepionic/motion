<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ResetSoeDriveCommand" Id="{d2e4bd39-ad58-40f0-ab64-e3a9d0c9c793}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'linkalways'} 
{attribute 'no_explicit_call' := 'This FB is a CLASS and must be accessed using methods or properties'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK PUBLIC ResetSoeDriveCommand EXTENDS Mc2Command IMPLEMENTS AsyncCommand
VAR
	fb : Tc2_Mc2_Drive.Fb_SoeReset;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="CyclicCall" Id="{e1db1cf6-2a4e-4fab-9f7a-88e9fc600228}">
      <Declaration><![CDATA[METHOD PUBLIC CyclicCall]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.CyclicCall();
fb(Axis := axis.AxisRef, Timeout := T#10S);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnExecuting" Id="{4a18f9dc-4049-4e4a-abb9-b3027d4bd077}">
      <Declaration><![CDATA[METHOD PROTECTED OnExecuting
VAR_INPUT
	state_control : AsyncCommandStateControl;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT fb.Busy THEN
	IF fb.Error THEN
		state_control.Error(fb.AdsErrId);
	ELSE
		state_control.Next();
	END_IF
	fb.Execute := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnInitializing" Id="{72a2e28a-d29f-4a9b-8d7e-ba26cca6986b}">
      <Declaration><![CDATA[METHOD PROTECTED OnInitializing
VAR_INPUT
	state_control	: Nepionic_Core.AsyncCommandStateControl;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fb(Axis := axis.AxisRef, Timeout := T#10S, Execute := TRUE);

IF fb.Busy THEN
	state_control.Next();
END_IF

IF fb.Error THEN
	state_control.Error(fb.AdsErrId);
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>